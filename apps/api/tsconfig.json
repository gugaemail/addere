{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    // o build de produção é feito pelo tsup; o tsc roda apenas como type-check
    // (--noEmit). Sem rootDir/composite os fontes de @addere/types, importados
    // direto do source no monorepo, não violam os limites do projeto.
    "composite": false
  },
  "include": ["src/**/*"]
}

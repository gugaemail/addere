# Neon — connection pooler (pgBouncer) — usado pela aplicação
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon — conexão direta — usado pelo Prisma CLI (migrate, introspect, studio)
DATABASE_URL_DIRECT="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Chave de 64 chars hex (32 bytes) para criptografar credenciais Protheus
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROTHEUS_ENCRYPTION_KEY=""  # OBRIGATÓRIO: gere com: openssl rand -hex 32

NODE_ENV="development"
PORT="3333"
CORS_ORIGIN="http://localhost:3000"

# E-mail de recuperação de senha (Resend — https://resend.com)
RESEND_API_KEY=""

# URL do painel web (usada no link do e-mail de reset)
WEB_URL="https://addere-web.vercel.app"

# Pasta local para screenshots dos reportes da Central de Ajuda
UPLOAD_DIR=uploads

# Camada de Inteligência
# INTEL_SQL_ADAPTER=mock usa dados sintéticos (dev/smoke sem Protheus real)
INTEL_SQL_ADAPTER=protheus
# Observabilidade (opcional) — DSN do Sentry da API; sem ele, captura vira no-op
SENTRY_DSN=
# Agente LLM da Inteligência (E6) — sem ANTHROPIC_API_KEY tudo cai no só-motor
ANTHROPIC_API_KEY=
INTEL_LLM_MODEL=claude-sonnet-5
INTEL_LLM_ENABLED=true
INTEL_LLM_DAILY_TOKEN_CAP=500000
# Geocodificação (E15-F1) — nominatim (padrão, sem chave), google (requer chave+billing) ou mock (dev/smoke)
# O Nominatim resolveu 40% de uma base real de ERP (endereço sem número nem
# bairro); com google, o que ele não achou é tentado de novo automaticamente.
INTEL_GEOCODER=nominatim
# Chave SEPARADA da chave de Maps do app: aquela é restrita por (package, SHA-1)
# e chamada de servidor volta REQUEST_DENIED. Restrinja esta por IP e à Geocoding API.
GOOGLE_GEOCODING_API_KEY=
# Endereços por execução do job GEO (padrão 300). 300 cabe no noturno ao limite de
# 1 req/s do Nominatim; com google dá para subir e fazer a carga inicial de uma vez.
INTEL_GEO_MAX_PER_RUN=300

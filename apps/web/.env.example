# URL da API (apps/api) consumida pelo painel e pelas rotas /api/* do Next
NEXT_PUBLIC_API_URL=http://localhost:3333

# URL pública do painel admin (usada no link do email de relatório semanal)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (Neon) via Prisma — o web acessa o banco diretamente (@addere/db) em:
# app/api/pilot/[pilotId]/export, app/api/cron/weekly-report, lib/metrics/pilot e lib/email/sendWeeklyReport
# Usar a URL do connection pooler (mesmo valor de DATABASE_URL da apps/api)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Conexão direta — só o Prisma CLI (migrate/studio) usa; opcional no web/Vercel
# DATABASE_URL_DIRECT="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Resend — envio de email do relatório semanal de piloto
# Gerar em: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Segredo para proteger o endpoint de cron (/api/cron/weekly-report) e as rotas /api/pilot/*
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configurar também em: Vercel Dashboard → Project Settings → Cron Job Secret
CRON_SECRET=change-me-cron-secret

# DSN do Sentry para rastreamento de erros no admin
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz

# Identificador do ambiente (development | staging | production)
APP_ENV=development

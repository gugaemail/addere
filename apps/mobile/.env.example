# URL da API backend — ajuste para o IP/domínio do seu ambiente
EXPO_PUBLIC_API_URL=http://localhost:3333

# URL direta do servidor Protheus (REST)
EXPO_PUBLIC_PROTHEUS_URL=http://localhost:8080

# DSN do Sentry para rastreamento de erros — obrigatório em todos os ambientes
EXPO_PUBLIC_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz

# Identificador do ambiente (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Versão do app no formato SemVer — deve corresponder ao version no app.config.js
EXPO_PUBLIC_APP_VERSION=1.0.0

# Desativa o upload automático de source maps/dSYMs do Sentry no build nativo.
# Fica "true" em development e preview (eas.json). No perfil production a chave
# NÃO existe — lá o upload é ligado, senão o erro chega como bytecode Hermes
# minificado e a stack não diz em que arquivo quebrou.
SENTRY_DISABLE_AUTO_UPLOAD=true

# Upload de source maps do Sentry — só é lido quando SENTRY_DISABLE_AUTO_UPLOAD
# está ausente/false. No EAS as três vivem no ambiente "production"
# (`eas env:create production --name <nome>`); o token é `secret`, os outros dois
# `plaintext`. Localmente pode deixar em branco: o upload fica desligado.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Mapa do plano (E13b) — chave Google Maps Android (restrita por package/SHA-1).
# Local: cole aqui p/ `expo run:android`; EAS: cadastrar como secret (E0-10).
GOOGLE_MAPS_ANDROID_API_KEY=

// Prisma schema — Addere ERP Mobile
// Banco: PostgreSQL | ORM: Prisma 5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum Role {
  SUPERADMIN // administrador da plataforma (painel web)
  ADMIN // administrador da empresa (app mobile)
  SALESPERSON // vendedor (app mobile)
}

enum OrderStatus {
  PENDING // criado localmente, aguardando sincronização
  SYNCED // enviado com sucesso ao Protheus
  CANCELLED
}

enum PilotEventType {
  // Camada de Inteligência (E12)
  PLAN_OPENED
  VISIT_CHECKIN
  VISIT_RESULT
  MESSAGE_SENT
  PLAN_EDITED

  ORDER_STARTED
  ORDER_COMPLETED
  ORDER_SYNCED
  ORDER_SYNC_FAILED
  SESSION_STARTED
  CATALOG_LOADED
}

enum PilotStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────
// Company — empresas (tenants)
// ─────────────────────────────────────────

model Company {
  id         String  @id @default(uuid())
  name       String
  cnpj       String  @unique
  idProtheus String? // código da empresa no ERP Protheus
  active     Boolean @default(true)

  // ─── Bloqueio de acesso (plano 017) — null = liberado ───
  accessBlockedAt   DateTime?
  accessBlockReason AccessBlockReason?
  blockExemptUntil  DateTime?          @db.Date // liberado pelo superadmin até este dia (São Paulo), inclusive

  // URLs das APIs Protheus configuradas por empresa
  apiToken     String? // POST autenticação — retorna Bearer token
  apiPord      String? // GET produtos
  apiCliente   String? // GET clientes
  apiMetaVend  String? // GET metas de vendedor
  apiPedido    String? // POST pedido
  apiConsPed   String? // GET consulta pedido
  apiCondPag   String? // GET condições de pagamento
  apiTransp    String? // GET transportadoras
  usrProtheus  String? // usuário para autenticação na API Protheus
  passProtheus String? // senha para autenticação na API Protheus
  syncConfig   Json? // mapeamento de campos Protheus por entidade (JSONB)
  fieldConfig  Json? // visibilidade de campos por empresa: { hidden: string[] }
  syncSchedule Json? // agendamento de sync: { products: {...}, customers: {...} }

  // ─── Camada de Inteligência ───
  apiSql              String? // POST SELECT genérico (webservice "qualquer SELECT")
  intelligenceEnabled Boolean @default(false) // liga a camada de inteligência (plano Business+)
  intelligenceConfig  Json? // { syncHour, syncEveryHours, defaultTone, retentionDays, lgpdNoticeAcceptedAt }

  // ─── Custo de IA (Gestão Addere): orçamento mensal do agente, só informativo ───
  llmMonthlyTokenBudget Int? // tokens cobráveis por mês (entrada + saída + gravação de cache); null = sem orçamento
  llmMonthlyBudgetBrl   Decimal? @db.Decimal(12, 2) // R$ por mês; null = sem orçamento

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches        Branch[]
  users           User[]
  customers       Customer[]
  products        Product[]
  orders          Order[]
  transportadoras Transportadora[]
  condPags        CondPag[]
  pilots          Pilot[]
  protheusLogs    ProtheusLog[]

  intelQueries          IntelQuery[]
  intelParameters       IntelParameter[]
  intelParameterHistory IntelParameterHistory[]
  intelSalesItems       SalesItem[]
  intelOpenTitles       OpenTitle[]
  syncCursors           IntelSyncCursor[]
  intelGoalSnapshots    GoalSnapshot[]
  intelJobRuns          IntelJobRun[]
  customerSignals       CustomerSignal[]
  visitPlans            VisitPlan[]
  visits                Visit[]
  customerMessages      CustomerMessage[]
  intelFeedbacks        IntelFeedback[]
  intelLlmCache         IntelLlmCache[]
  intelLlmCalls         IntelLlmCall[]
  evalCases             EvalCase[]
  geoAddresses          GeoAddress[]
  customerWindows       CustomerWindow[]

  // ─── Gestão Addere (plano 013) ───
  clientProfile     ClientProfile?
  contract          CompanyContract?
  billingEvents     BillingEvent[]
  // ─── Contrato e aceite (plano 014) ───
  contractDocuments ContractDocument[]
  // ─── Faturamento (plano 016) ───
  invoices          Invoice[]
  // ─── Licenças adicionais (plano 015) ───
  licenseRequests   LicenseRequest[]

  @@map("companies")
}

// ─────────────────────────────────────────
// Branch — filiais de uma empresa
// ─────────────────────────────────────────

model Branch {
  id          String  @id @default(uuid())
  name        String
  cnpj        String?
  idProtheus  String? // código da filial no ERP Protheus
  razaoSocial String?
  endereco    String?
  complemento String?
  cidade      String?
  estado      String?
  cep         String?
  logo        String? // base64 data URL da logo
  active      Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("branches")
}

// ─────────────────────────────────────────
// User — vendedores e administradores
// ─────────────────────────────────────────

model User {
  id         String  @id @default(uuid())
  name       String
  email      String  @unique
  password   String
  role       Role    @default(SALESPERSON)
  active     Boolean @default(true) // soft delete
  idVendProt String? // código do vendedor no Protheus — interpolado em {{VENDEDOR}}, validado por regex no Zod

  // ─── Camada de Inteligência (cfg_vendedor do doc + hierarquia D3b) ───
  visitsPerDay Int? // capacidade de visitas/dia (default da premissa visits_per_day)
  vehicle      Vehicle? // afeta tempo de deslocamento (F2)
  servedCities String[] @default([]) // cidades atendidas (agrupamento do plano)
  messageTone  String? // tom das mensagens geradas (sobrepõe o default da empresa)
  managerId    String? // gerente comercial do vendedor (usuário com intel.manager)
  manager      User?    @relation("SellerManager", fields: [managerId], references: [id], onDelete: SetNull)
  sellers      User[]   @relation("SellerManager")

  // null para SUPERADMIN; obrigatório para ADMIN e SALESPERSON
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens          RefreshToken[]
  orders                 Order[]
  pilotEvents            PilotEvent[]         @relation("UserPilotEvents")
  pilotFeedbacks         PilotFeedback[]      @relation("UserPilotFeedbacks")
  passwordResetTokens    PasswordResetToken[]
  helpReports            HelpReport[]
  permissions            UserPermission[]
  billingEvents          BillingEvent[]       @relation("BillingEventActor")
  contractTermsCreated   ContractTerms[]      @relation("ContractTermsAuthor")
  designatedInContracts  CompanyContract[]    @relation("ContractDesignatedAdmin")
  licenseRequestsMade    LicenseRequest[]     @relation("LicenseRequestRequester")
  licenseRequestsDecided LicenseRequest[]     @relation("LicenseRequestDecider")

  @@unique([companyId, idVendProt]) // dois usuários com o mesmo código veriam o mesmo plano (§8 do plano)
  @@map("users")
}

// ─────────────────────────────────────────
// Permission — catálogo de permissões disponíveis
// ─────────────────────────────────────────

model Permission {
  id       String @id @default(uuid())
  key      String @unique // ex: "orders.change_carrier"
  label    String // texto exibido no painel web
  category String // agrupamento na UI: "orders", "sync", "users"...

  userPermissions UserPermission[]

  @@map("permissions")
}

// ─────────────────────────────────────────
// UserPermission — permissões concedidas por usuário
// ─────────────────────────────────────────

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId]) // presença da linha = permissão concedida
  @@map("user_permissions")
}

// ─────────────────────────────────────────
// PasswordResetToken — tokens de redefinição de senha
// ─────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────
// RefreshToken — tokens de renovação JWT
// ─────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// Customer — clientes dos vendedores
// ─────────────────────────────────────────

model Customer {
  id            String    @id @default(uuid())
  protheusCode  String? // código do cliente no ERP Protheus
  loja          String? // código da loja (chave composta com protheusCode)
  vendorCode    String? // código do vendedor responsável (A1_VEND no Protheus)
  name          String
  document      String? // CPF ou CNPJ (único por empresa)
  email         String?
  phone         String?
  address       String?
  municipio     String?
  bairro        String?
  cep           String?
  uf            String?
  ultcom        DateTime? // data da última compra no Protheus (A1_ULTCOM)
  msblql        String? // A1_MSBLQL: "1"=bloqueado (aparece, sem pedido), "2"=liberado
  transpPadrao  String? // A1_TRANSP: código da transportadora padrão do cliente
  condPagPadrao String? // A1_COND: código da condição de pagamento padrão do cliente
  tes           String? // A1_TES: código TES (enviado ao Protheus no pedido)
  xcodemp       String? // A1_XCODEMP: código da filial Protheus de faturamento
  creditLimit   Decimal?  @db.Decimal(14, 2) // limite de crédito (A1_LC) — enriquecido pelo contrato "clientes"
  segment       String? // segmento do cliente — enriquecido pelo contrato "clientes"
  active        Boolean   @default(true) // soft delete

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@unique([companyId, loja, protheusCode])
  @@unique([companyId, document])
  @@index([companyId, active])
  @@index([companyId, name])
  @@map("customers")
}

// ─────────────────────────────────────────
// Product — catálogo de produtos por empresa
// ─────────────────────────────────────────

model Product {
  id           String  @id @default(uuid())
  protheusCode String? // código do produto no ERP Protheus (único por empresa)
  name         String
  description  String?
  price        Decimal @db.Decimal(10, 2) // preço geral (UF em branco na tabela de preço)
  ufPrices     Json? // preço por UF do cliente, { "SP": 11.2 } — vence o preço geral
  unit         String  @default("UN") // unidade de medida
  stock        Decimal @default(0) @db.Decimal(10, 3)
  saldo        Decimal @default(0) @db.Decimal(10, 2) // saldo disponível
  productGroup String? // grupo de produtos (B1_GRUPO) — enriquecido pelo contrato "produtos"
  active       Boolean @default(true) // soft delete

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([companyId, protheusCode])
  @@index([companyId, active])
  @@index([companyId, name])
  @@map("products")
}

// ─────────────────────────────────────────
// Transportadora
// ─────────────────────────────────────────

model Transportadora {
  id           String  @id @default(uuid())
  protheusCode String?
  nome         String

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())

  orders Order[]

  @@unique([companyId, protheusCode])
  @@map("transportadoras")
}

// ─────────────────────────────────────────
// CondPag — condições de pagamento
// ─────────────────────────────────────────

model CondPag {
  id           String  @id @default(uuid())
  protheusCode String?
  nome         String

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())

  orders Order[]

  @@unique([companyId, protheusCode])
  @@map("cond_pags")
}

// ─────────────────────────────────────────
// Order — pedidos de venda
// ─────────────────────────────────────────

model Order {
  id              String      @id @default(uuid())
  status          OrderStatus @default(PENDING)
  total           Decimal     @db.Decimal(10, 2)
  notes           String?
  protheusOrderId String?     @unique // ID do pedido no ERP após sincronização
  protheusStatus  String? // último status consultado no Protheus
  syncedAt        DateTime? // data/hora da sincronização com o Protheus
  emissao         DateTime? // data de criação do pedido (informada pelo usuário)
  mennota         String? // mensagem para nota fiscal

  userId String
  user   User   @relation(fields: [userId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  transportId    String?
  transportadora Transportadora? @relation(fields: [transportId], references: [id])

  condId  String?
  condPag CondPag? @relation(fields: [condId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([userId, companyId])
  @@index([companyId, status])
  @@map("orders")
}

// ─────────────────────────────────────────
// OrderItem — itens do pedido
// ─────────────────────────────────────────

model OrderItem {
  id           String   @id @default(uuid())
  quantity     Decimal  @db.Decimal(10, 3)
  unitPrice    Decimal  @db.Decimal(10, 2)
  discount     Decimal  @default(0) @db.Decimal(5, 2) // percentual de desconto
  total        Decimal  @db.Decimal(10, 2)
  descricao    String? // descrição do item (sobrescreve nome do produto se informado)
  largura      Decimal? @db.Decimal(10, 3) // C6_XLARGUR
  espessura    Decimal? @db.Decimal(10, 3) // C6_XEXPESS
  encolhimento String? // C6_XENCOLH
  xcrav        String? // C6_XCRAV: "1"=Sim, "2"=Não
  tara         Decimal? @db.Decimal(10, 3) // C6_XTARA

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@map("order_items")
}

// ─────────────────────────────────────────
// Pilot — piloto comercial por empresa
// ─────────────────────────────────────────

model Pilot {
  id         String      @id @default(cuid())
  clientName String
  startDate  DateTime
  endDate    DateTime
  status     PilotStatus @default(ACTIVE)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  events    PilotEvent[]
  feedbacks PilotFeedback[]

  createdAt DateTime @default(now())

  @@map("pilots")
}

// ─────────────────────────────────────────
// PilotEvent — eventos rastreados do piloto
// ─────────────────────────────────────────

model PilotEvent {
  id         String         @id @default(cuid())
  pilotId    String
  repId      String
  eventType  PilotEventType
  metadata   Json           @default("{}")
  occurredAt DateTime       @default(now())

  pilot Pilot @relation(fields: [pilotId], references: [id])
  rep   User  @relation("UserPilotEvents", fields: [repId], references: [id])

  @@index([pilotId, eventType, occurredAt])
  @@map("pilot_events")
}

// ─────────────────────────────────────────
// PilotFeedback — avaliações dos representantes
// ─────────────────────────────────────────

model PilotFeedback {
  id      String  @id @default(cuid())
  pilotId String
  repId   String
  orderId String?
  rating  String // 'positive' | 'negative'
  comment String?

  pilot Pilot @relation(fields: [pilotId], references: [id])
  rep   User  @relation("UserPilotFeedbacks", fields: [repId], references: [id])

  createdAt DateTime @default(now())

  @@map("pilot_feedbacks")
}

// ─────────────────────────────────────────
// HelpReport — reportes de problemas da Central de Ajuda
// ─────────────────────────────────────────

model HelpReport {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          String // "pedido_nao_enviou" | "app_travou" | "dados_incorretos" | "falha_sync" | "login" | "outro"
  description   String
  appVersion    String?
  device        String?
  screenshotUrl String? // caminho relativo: /uploads/help-reports/{userId}/{ticketId}.{ext}
  status        String   @default("aberto") // "aberto" | "em_analise" | "resolvido"
  ticketId      String   @unique @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("help_reports")
}

// ─────────────────────────────────────────
// ProtheusLog — log de chamadas às APIs Protheus
// ─────────────────────────────────────────

model ProtheusLog {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  operation     String // ex: syncProducts, syncCustomers, syncOrder, testToken
  endpointKey   String // ex: apiPord, apiCliente, apiPedido, apiToken
  success       Boolean
  httpStatus    Int? // código HTTP da última resposta (se disponível)
  durationMs    Int? // duração total da operação em ms
  recordsSynced Int? // registros gravados no banco
  totalRecords  Int? // total de registros disponíveis na fonte
  errorMessage  String? // mensagem de erro truncada (max 500 chars)
  metadata      Json? // dados extras: orderId, protheusOrderId, etc.
  createdAt     DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, operation, success])
  @@map("protheus_logs")
}

// ═════════════════════════════════════════
// Camada de Inteligência (plano E1b — ingestão)
// Convenções: companyId como tenant, dinheiro Decimal(14,2), tabelas intel_*
// ═════════════════════════════════════════

enum IntelQueryName {
  CUSTOMERS // contrato "clientes" (SA1)
  SALES // contrato "vendas" (SD2/SF2 ou SC5/SC6)
  OPEN_TITLES // contrato "títulos em aberto" (SE1)
  PRODUCTS // contrato "produtos" (SB1)
  STOCK // contrato "estoque" (ao vivo, {{PRODUTO}})
}

enum IntelQueryScope {
  ALL // roda por tenant, todos os vendedores
  PER_SELLER // exige {{VENDEDOR}}
}

enum IntelJob {
  NIGHTLY // composto: SYNC completo → GOALS → ENGINE → PLAN → PURGE
  REFRESH // composto: SALES incremental + OPEN_TITLES → ENGINE
  SYNC
  GOALS
  ENGINE
  PLAN
  GEO
  PURGE
  EVAL
}

enum IntelJobRunStatus {
  RUNNING
  OK
  ERROR
}

// ─────────────────────────────────────────
// IntelQuery — consulta SQL configurável por tenant (cfg_consulta do doc)
// ─────────────────────────────────────────

model IntelQuery {
  id    String          @id @default(uuid())
  name  IntelQueryName
  scope IntelQueryScope @default(ALL)
  sql   String

  // Aba "O que significa" — vai no prompt do agente
  definition String? // definição em português
  exclusions String? // o que a consulta exclui (devolução, bonificação…)
  gotchas    String? // pegadinhas conhecidas

  version     Int       @default(1)
  validatedAt DateTime?
  validatedBy String?

  // Reconciliação obrigatória antes de publicar
  reconciliationPeriod     String? // 'YYYYMM' (mês fechado) ou 'YYYYMMDD' (posição do dia)
  reconciliationRefAmount  Decimal? @db.Decimal(14, 2) // valor oficial informado pelo admin
  reconciliationCalcAmount Decimal? @db.Decimal(14, 2) // soma desta consulta no período
  // Percentual, não valor: número oficial errado por ordem de grandeza gera
  // diferença na casa dos milhares por cento. Em DECIMAL(6,2) (teto 9999,99)
  // o UPDATE estourava com overflow numérico e a reconciliação virava 500.
  reconciliationDiffPct    Decimal? @db.Decimal(12, 2)

  published   Boolean   @default(false)
  publishedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name, version])
  @@index([companyId, name, published])
  @@map("intel_queries")
}

// ─────────────────────────────────────────
// IntelParameter — premissas do motor por tenant (cfg_premissa do doc)
// segment "" = global (evita o problema de unique com NULL no Postgres)
// ─────────────────────────────────────────

model IntelParameter {
  id        String  @id @default(uuid())
  key       String // ex: late_factor, risk_days, weight_value…
  value     Json
  segment   String  @default("") // "" = global; senão, segmento do cliente
  changedBy String? // userId de quem alterou

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, key, segment])
  @@map("intel_parameters")
}

model IntelParameterHistory {
  id        String  @id @default(uuid())
  key       String
  value     Json
  segment   String  @default("")
  changedBy String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  changedAt DateTime @default(now())

  @@index([companyId, key])
  @@map("intel_parameter_history")
}

// ─────────────────────────────────────────
// SalesItem — item de venda histórica vindo do contrato "vendas" (crm_venda_item)
// PK composta natural; itemSeq = D2_ITEM/C6_ITEM ("00" quando o contrato não traz)
// ─────────────────────────────────────────

model SalesItem {
  companyId    String
  orderRef     String // pedido/nota (ex: D2_DOC+D2_SERIE ou C5_NUM)
  itemSeq      String   @default("00")
  productCode  String
  date         DateTime @db.Date
  customerCode String
  loja         String
  vendorCode   String?
  quantity     Decimal  @db.Decimal(12, 3)
  amount       Decimal  @db.Decimal(14, 2)
  productDesc  String?
  productGroup String?
  syncedAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, orderRef, itemSeq, productCode])
  @@index([companyId, customerCode, loja, date])
  @@index([companyId, vendorCode, date])
  @@map("intel_sales_items")
}

// ─────────────────────────────────────────
// OpenTitle — título em aberto (contrato "títulos", SE1) — crm_titulo
// Replace total por tenant a cada sync
// ─────────────────────────────────────────

model OpenTitle {
  companyId    String
  titleRef     String
  customerCode String
  loja         String
  dueDate      DateTime @db.Date
  balance      Decimal  @db.Decimal(14, 2)
  daysOverdue  Int? // obsoleto: o atraso é calculado de dueDate na leitura (daysOverdueOn)
  syncedAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, titleRef])
  @@index([companyId, customerCode, loja])
  @@map("intel_open_titles")
}

// Marca d'água do sync incremental por contrato (plano 009): o maior S_T_A_M_P_
// que o Protheus devolveu, na forma canônica 'AAAA-MM-DD hh:mm:ss.mmm' (texto
// ordenável, sem fuso — é o datetime do SQL Server do cliente). Sem linha aqui,
// a próxima execução do contrato é completa; publicar versão nova da consulta
// apaga a linha.
model IntelSyncCursor {
  companyId  String
  name       IntelQueryName
  stamp      String
  lastFullAt DateTime?
  updatedAt  DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, name])
  @@map("intel_sync_cursors")
}

// ─────────────────────────────────────────
// GoalSnapshot — captura da meta do vendedor via apiMetaVend (crm_meta_hist)
// Append-only: cada captura gera uma linha nova
// ─────────────────────────────────────────

model GoalSnapshot {
  id               String   @id @default(uuid())
  vendorCode       String // User.idVendProt
  period           String // 'YYYYMM'
  goalAmount       Decimal? @db.Decimal(14, 2)
  soldAmount       Decimal? @db.Decimal(14, 2)
  goalPositivation Decimal? @db.Decimal(6, 2)
  capturedAt       DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId, vendorCode, period])
  @@map("intel_goal_snapshots")
}

// ─────────────────────────────────────────
// IntelJobRun — lock e histórico de execução dos jobs de inteligência
// Base do pill "sinc. 03h12", da tela Saúde e do catch-up no boot
// ─────────────────────────────────────────

model IntelJobRun {
  id          String            @id @default(uuid())
  job         IntelJob
  status      IntelJobRunStatus @default(RUNNING)
  startedAt   DateTime          @default(now())
  finishedAt  DateTime?
  error       String?
  metadata    Json? // { queryId, window, rows, progress… }
  lockedUntil DateTime? // lock distribuído: só um processo roda o job por tenant

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId, job, startedAt])
  @@map("intel_job_runs")
}

// ═════════════════════════════════════════
// Camada de Inteligência (plano E1c — motor, plano do dia e execução)
// ═════════════════════════════════════════

enum Vehicle {
  CAR
  MOTORCYCLE
  FOOT
}

enum CustomerStatus {
  NEW // < cycle_min_orders pedidos: sem ciclo confiável
  ON_CYCLE // dias sem compra ≤ late_factor × ciclo
  LATE // entre late_factor× e risk_factor× o ciclo
  AT_RISK // > risk_factor× o ciclo ou > risk_days
  INACTIVE // > active_days sem compra
  BLOCKED // título vencido > blocked_days, limite estourado ou A1_MSBLQL=1 — sobrepõe os demais
}

enum SignalConfidence {
  HIGH // ≥ 8 pedidos em 12m
  MEDIUM // 3–7 pedidos
  LOW // < 3 pedidos (status NEW)
}

enum PlanKind {
  DAY
  WEEK
}

enum PlanStatus {
  GENERATED
  EDITED // vendedor/gestor mexeu — o motor não sobrescreve no mesmo dia
  IN_PROGRESS
  CLOSED
}

enum PlanItemOrigin {
  ENGINE
  MANAGER
  SELLER
}

enum MessageTemplate {
  STALLED_PROPOSAL // proposta parada
  WENT_QUIET // cliente sumiu
  REACTIVATE // reativar inativo
}

enum VisitResult {
  ORDER
  NO_ORDER
  NOT_FOUND
  RESCHEDULED
}

enum VisitSource {
  CHECKIN // vendedor tocou em "Cheguei"
  ORDER // inferida: o pedido vale como check-in (plano 006)
  REMOTE // atendimento à distância: telefone ou WhatsApp, sem GPS (plano 011)
}

enum ContactChannel {
  PHONE
  WHATSAPP
}

enum FeedbackTargetType {
  PLAN
  ITEM
  MESSAGE
  ANSWER
}

enum GeoPrecision {
  ROOFTOP
  STREET
  CEP
  CITY // não posiciona pino no mapa
}

// ─────────────────────────────────────────
// CustomerSignal — sinais calculados pelo motor por cliente (crm_sinal_cliente)
// Sobrescrito a cada recálculo (ENGINE)
// ─────────────────────────────────────────

model CustomerSignal {
  companyId    String
  customerCode String
  loja         String

  computedAt            DateTime         @default(now())
  cycleDays             Int? // mediana dos intervalos entre pedidos (12m)
  daysSinceLastPurchase Int?
  status                CustomerStatus
  confidence            SignalConfidence
  orders12m             Int              @default(0)
  avgTicket             Decimal?         @db.Decimal(14, 2)
  trendPct              Decimal?         @db.Decimal(6, 2) // ticket 3m vs 12m
  purchaseProb          Decimal?         @db.Decimal(4, 3)
  rfmR                  Int? // fase 2
  rfmF                  Int?
  rfmM                  Int?
  rfmSegment            String?
  usualMix              Json? // produtos em ≥2 dos últimos 3 ciclos
  cutMix                Json? // habitual ausente no último pedido
  crossSell             Json? // fase 2
  scoreValue            Decimal?         @db.Decimal(6, 3)
  scoreUrgency          Decimal?         @db.Decimal(6, 3)
  scoreRisk             Decimal?         @db.Decimal(6, 3)
  scoreTotal            Decimal?         @db.Decimal(6, 3)
  reasons               Json? // frases prontas em PT ("compra a cada 28 dias, está no dia 41")

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, customerCode, loja])
  @@index([companyId, status])
  @@map("intel_customer_signals")
}

// ─────────────────────────────────────────
// VisitPlan / VisitPlanItem — plano do dia/semana por vendedor (crm_plano/_item)
// ─────────────────────────────────────────

model VisitPlan {
  id             String     @id @default(uuid())
  vendorCode     String // User.idVendProt
  date           DateTime   @db.Date // dia civil em America/Sao_Paulo
  kind           PlanKind   @default(DAY)
  generatedAt    DateTime   @default(now())
  engineVersion  String?
  goalGap        Decimal?   @db.Decimal(14, 2)
  expectedAmount Decimal?   @db.Decimal(14, 2)
  grouping       String? // cidade/bairro do dia
  llmSummary     String? // frase do agente na home (null = fallback só-motor)
  status         PlanStatus @default(GENERATED)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  items VisitPlanItem[]

  @@unique([companyId, vendorCode, date, kind])
  @@index([companyId, date])
  @@map("intel_visit_plans")
}

model VisitPlanItem {
  id              String         @id @default(uuid())
  planId          String
  plan            VisitPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  position        Int
  customerCode    String
  loja            String
  statusAtTime    CustomerStatus
  scoreAtTime     Decimal?       @db.Decimal(6, 3)
  shortReason     String? // "o porquê" no card
  suggestedOffer  Json? // mix sugerido + "perguntar sobre X cortado"
  expectedAmount  Decimal?       @db.Decimal(14, 2)
  origin          PlanItemOrigin @default(ENGINE)
  signalsSnapshot Json? // snapshot determinístico p/ "antes de entrar" offline (E7/E13)
  removedAt       DateTime? // SideEffect: tirado do dia (editar é sinal)
  movedToPlanId   String?

  // Preenchidos quando há geocodificação (E15-F1); ordem por distância (E16)
  lat           Decimal?  @db.Decimal(9, 6)
  lng           Decimal?  @db.Decimal(9, 6)
  distFromPrevM Int?
  etaMin        Int?
  plannedTime   String? // "08:30"
  // Plano semanal (E18): dia civil da parada; null nos planos do dia
  plannedDate   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, position])
  @@map("intel_visit_plan_items")
}

// ─────────────────────────────────────────
// Visit — check-in e resultado da visita (crm_visita)
// clientId: uuid gerado no app (idempotência offline) — único POR TENANT (§8)
// ─────────────────────────────────────────

model Visit {
  id               String          @id @default(uuid())
  clientId         String // uuid gerado no app
  vendorCode       String
  customerCode     String
  loja             String
  planItemId       String? // null = visita fora do plano (sinal importante)
  arrivedAt        DateTime
  leftAt           DateTime?
  lat              Decimal?        @db.Decimal(9, 6) // GPS só no check-in (D10); zerado após 90 dias (D4)
  lng              Decimal?        @db.Decimal(9, 6)
  accuracyM        Int?
  result           VisitResult?
  source           VisitSource     @default(CHECKIN)
  channel          ContactChannel? // só em source=REMOTE (plano 011)
  noOrderReason    String?
  orderId          String? // Order.id quando result=ORDER
  notes            String?
  createdOfflineAt DateTime?
  syncedAt         DateTime        @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, clientId])
  @@index([companyId, vendorCode, arrivedAt])
  @@map("intel_visits")
}

// ─────────────────────────────────────────
// CustomerMessage — mensagem WhatsApp gerada (crm_mensagem)
// ─────────────────────────────────────────

model CustomerMessage {
  id           String          @id @default(uuid())
  vendorCode   String
  customerCode String
  loja         String
  template     MessageTemplate
  text         String // expurgado após retentionDays (D4)
  generatedAt  DateTime        @default(now())
  sentAt       DateTime?
  channel      String? // 'whatsapp' | 'copy'

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId, vendorCode, generatedAt])
  @@map("intel_customer_messages")
}

// ─────────────────────────────────────────
// IntelFeedback — 👍/👎 do vendedor sobre plano/item/mensagem (crm_feedback)
// ─────────────────────────────────────────

model IntelFeedback {
  id         String             @id @default(uuid())
  vendorCode String
  targetType FeedbackTargetType
  targetId   String
  rating     Int                @db.SmallInt // +1 / -1
  comment    String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, targetType, createdAt])
  @@map("intel_feedbacks")
}

// ─────────────────────────────────────────
// IntelLlmCache — cache de respostas do agente (4h) + uso de tokens (custo)
// ─────────────────────────────────────────

model IntelLlmCache {
  id                  String   @id @default(uuid())
  kind                String // 'today' | 'briefing' | 'message' | …
  vendorCode          String
  targetKey           String   @default("") // ex: customerCode:loja ou template
  payload             Json
  expiresAt           DateTime // expurgo no job PURGE
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  cacheReadTokens     Int      @default(0)
  cacheCreationTokens Int      @default(0) // gravado no cache de prompt (cobrado a 1,25×)
  model               String?
  latencyMs           Int?
  createdAt           DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, kind, vendorCode, targetKey])
  @@index([companyId, expiresAt])
  @@map("intel_llm_cache")
}

// Registro de toda geração do agente (plano 012) — sucesso, cache e cada tipo
// de só-motor, com os tokens de TODAS as tentativas. Alimenta o teto diário,
// o custo do mês e o alarme de queda. Sem texto e sem cliente: nada de LGPD.
// Expurgo em 90 dias (job PURGE).
model IntelLlmCall {
  id                  String   @id @default(uuid())
  kind                String // 'today' | 'briefing' | 'message' | …
  vendorCode          String // 'eval' nos casos de regressão; '*' em perdas sem filtro
  source              String // 'llm' | 'cache' | 'engine'
  reason              String? // motivo do só-motor, com números trocados por N
  attempts            Int      @default(0) // chamadas feitas ao modelo (0, 1 ou 2)
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  cacheReadTokens     Int      @default(0)
  cacheCreationTokens Int      @default(0)
  model               String?
  latencyMs           Int?
  promptVersion       String
  createdAt           DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@map("intel_llm_calls")
}

// ─────────────────────────────────────────
// EvalCase — conjunto de regressão do agente (eval_caso)
// Snapshot gravado já pseudonimizado (D4)
// ─────────────────────────────────────────

model EvalCase {
  id            String    @id @default(uuid())
  vendorCode    String
  frozenDate    DateTime  @db.Date
  snapshot      Json
  expected      Json
  promptVersion String?
  lastResult    String?
  ranAt         DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("intel_eval_cases")
}

// ─────────────────────────────────────────
// GeoAddress — cache permanente de geocodificação (geo_endereco; E15-F1)
// Refeito só quando o endereço do cliente muda
// ─────────────────────────────────────────

model GeoAddress {
  companyId         String
  customerCode      String
  loja              String
  normalizedAddress String?
  cep               String?
  lat               Decimal?      @db.Decimal(9, 6)
  lng               Decimal?      @db.Decimal(9, 6)
  precision         GeoPrecision?
  source            String? // 'nominatim' | 'google' (D14a)
  geocodedAt        DateTime?
  error             String?

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, customerCode, loja])
  @@map("intel_geo_addresses")
}

// ─────────────────────────────────────────
// CustomerWindow — janela de atendimento do cliente (cfg_janela_cliente; E16)
// weekday 0=dom … 6=sáb; horários "HH:MM" no fuso America/Sao_Paulo
// ─────────────────────────────────────────

enum WindowSource {
  CADASTRO // cadastro do cliente (admin)
  SELLER // vendedor ajustou no app
  MANAGER // gerente ajustou no painel
}

model CustomerWindow {
  id           String       @id @default(uuid())
  customerCode String
  loja         String
  weekday      Int          @db.SmallInt
  startTime    String // "08:00"
  endTime      String // "12:00"
  source       WindowSource @default(SELLER)
  changedBy    String? // userId

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, customerCode, loja, weekday])
  @@map("intel_customer_windows")
}

// ═════════════════════════════════════════
// Gestão Addere — cadastro comercial, contrato e cobrança (planos 013 a 018)
// Só o SUPERADMIN escreve. Dinheiro Decimal(14,2). Competência e vencimento
// são @db.Date: meia-noite UTC do dia civil em America/Sao_Paulo, como
// VisitPlan.date. Antes do aceite nada começa: sem limite e sem cobrança.
// ═════════════════════════════════════════

enum LicenseType {
  STANDARD // Padrão — sem Inteligência
  INTELLIGENCE // Com Inteligência
}

enum ContractStatus {
  DRAFT // rascunho: só a Addere vê
  PENDING_ACCEPTANCE // enviado, esperando o aceite do ADMIN (plano 014)
  ACTIVE // aceito: limite e cobrança valem
  CANCELLED // encerrado (plano 016)
}

enum ContractTermsStatus {
  PROPOSED // ainda não vale; nunca conta para limite nem para cobrança
  EFFECTIVE // vale a partir de effectiveFrom; nunca mais é alterado
  WITHDRAWN // proposta descartada
}

enum ContractTermsOrigin {
  CONTRACT // termos do contrato original
  AMENDMENT // aditivo aceito pelo ADMIN (plano 014)
  LICENSE_REQUEST // pedido de licenças aprovado (plano 015)
}

/// Motivo do bloqueio de acesso da empresa (plano 017). Empresa desativada
/// (active=false) também fica bloqueada, mas pelo próprio `active`.
enum AccessBlockReason {
  OVERDUE // fatura vencida, depois do aviso de 10 dias — o sistema limpa sozinho
  // RESERVADO E DESABILITADO (decisão de 15/10/2026): nenhum código grava MANUAL.
  // O contrato só prevê suspensão por atraso; o bloqueio manual volta só em plano
  // próprio, com cláusula revisada. Se aparecer no banco, foi gravado à mão: a
  // regra não o limpa, e o "Liberar" da ficha limpa.
  MANUAL
}

// Catálogo de pacotes. O preço de tabela só pré-preenche o contrato; o valor
// negociado mora em ContractTerms.
model LicensePackage {
  id                             String   @id @default(uuid())
  code                           String   @unique // P10 | P20 | P30 | UNLIMITED; não muda depois de criado
  name                           String
  seats                          Int? // null = quantidade digitada no contrato (Ilimitado)
  listPriceStandard              Decimal? @db.Decimal(14, 2) // total mensal do pacote, Padrão
  listPriceIntelligence          Decimal? @db.Decimal(14, 2) // total mensal do pacote, Com Inteligência
  listExtraSeatPriceStandard     Decimal? @db.Decimal(14, 2) // por licença adicional, Padrão
  listExtraSeatPriceIntelligence Decimal? @db.Decimal(14, 2) // por licença adicional, Com Inteligência
  active                         Boolean  @default(true)
  sortOrder                      Int      @default(0)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  terms ContractTerms[]

  @@map("billing_license_packages")
}

// Cadastro comercial, 1:1 com Company. Separado de Company para os dados
// pessoais (representante legal e contatos) não vazarem nas listagens técnicas.
model ClientProfile {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id])

  legalName         String // razão social
  tradeName         String? // nome fantasia
  stateRegistration String? // inscrição estadual; "ISENTO" vale

  addressStreet     String?
  addressNumber     String?
  addressComplement String?
  addressDistrict   String? // bairro
  addressCity       String?
  addressState      String? // UF
  addressZip        String? // CEP, só dígitos

  // Representante legal — entra no quadro-resumo do contrato (plano 014)
  legalRepName String?
  legalRepCpf  String? // só dígitos
  legalRepRole String? // cargo

  contactName  String?
  contactEmail String?
  contactPhone String?

  // Contato de cobrança — recebe as faturas e os avisos (planos 016 e 017)
  billingContactName String?
  billingEmail       String?
  billingPhone       String?

  notes String? // observação interna da Addere; nunca vai ao contrato

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("billing_client_profiles")
}

// Contrato, 1:1 com Company. Sem linha = empresa sem contrato (teste, piloto
// ou implantação): sem limite e sem cobrança.
model CompanyContract {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  status                ContractStatus @default(DRAFT)
  startDate             DateTime?      @db.Date // dia do aceite em São Paulo (plano 014)
  graceMonths           Int            @default(0) // 0 = sem carência
  firstBilledCompetence DateTime?      @db.Date // gravada no aceite: mês do aceite + 1 + carência
  dueDay                Int // 1 a 10, validado no zod
  overdueBlockDays      Int? // null = padrão de BillingSettings
  seatGuardVersion      Int            @default(0) // linha de trava da criação de usuários (plano 015); não é dado

  // Administrador indicado pela Empresa (plano 014): o único que aceita o
  // contrato e os aditivos e pede licenças adicionais (015). Escolhido pelo
  // superadmin na aba Contrato. Ponteiro vivo, com chave estrangeira (exceção
  // da decisão de desenho 8).
  designatedAdminId String?
  designatedAdmin   User?   @relation("ContractDesignatedAdmin", fields: [designatedAdminId], references: [id])

  // Encerramento (plano 016): sem multa, com efeito no fim do mês, que é cobrado.
  // O contrato segue ACTIVE até endsAt; o agendador o passa a CANCELLED no dia seguinte.
  endsAt                 DateTime? @db.Date // último dia coberto (sempre o último dia de um mês)
  cancelRequestedAt      DateTime?
  cancelRequestedById    String?
  cancelReason           String?
  deactivateCompanyOnEnd Boolean   @default(false) // "Desativar empresa também"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms     ContractTerms[]
  documents ContractDocument[]

  @@map("billing_company_contracts")
}

// Versões dos termos. EFFECTIVE nunca é alterado: mudança vira versão nova.
// Só o PROPOSED de um contrato em DRAFT é editado no lugar.
model ContractTerms {
  id         String              @id @default(uuid())
  contractId String
  contract   CompanyContract     @relation(fields: [contractId], references: [id])
  version    Int // 1, 2, 3… por contrato
  status     ContractTermsStatus @default(PROPOSED)
  origin     ContractTermsOrigin @default(CONTRACT)

  proposedEffectiveFrom DateTime? // "vale a partir de" do aditivo (plano 014)
  effectiveFrom         DateTime? // gravado no aceite ou na aprovação

  packageId         String
  package           LicensePackage @relation(fields: [packageId], references: [id])
  licenseType       LicenseType
  includedSeats     Int // sempre preenchido: do pacote, ou digitado no Ilimitado
  extraSeats        Int            @default(0)
  packagePrice      Decimal        @db.Decimal(14, 2) // valor total mensal do pacote, negociado
  extraSeatPrice    Decimal        @db.Decimal(14, 2) // por licença adicional, negociado
  reason            String?
  // Aditivo a pedido da Empresa Contratante (plano 014): vale no aceite mesmo
  // com aumento de preço, e o motivo diz o que ela pediu
  requestedByClient Boolean        @default(false)

  createdById String?
  createdBy   User?   @relation("ContractTermsAuthor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents      ContractDocument[]
  licenseRequest LicenseRequest? // o pedido aprovado que criou estes termos (plano 015)

  @@unique([contractId, version])
  @@index([contractId, status])
  @@map("billing_contract_terms")
}

// Histórico e auditoria. O payload guarda só os NOMES dos campos alterados,
// nunca os valores (LGPD). `type` segue a lista fechada BILLING_EVENT_TYPES
// de @addere/types.
model BillingEvent {
  id        String   @id @default(uuid())
  type      String
  companyId String? // null nos eventos globais (pacotes e regras)
  company   Company? @relation(fields: [companyId], references: [id])
  actorId   String? // null = job (planos 016 e 017)
  actor     User?    @relation("BillingEventActor", fields: [actorId], references: [id])
  payload   Json     @default("{}")
  dedupeKey String?  @unique // idempotência dos e-mails (planos 016 e 017)
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("billing_events")
}

// Regras globais, linha única (id "global", criada pela migration).
model BillingSettings {
  id               String    @id @default("global")
  overdueBlockDays Int       @default(15) // dias de atraso para suspender; o contrato pode ter exceção
  dueReminderDays  Int       @default(3) // lembrete antes do vencimento (plano 016)
  autoBlockEnabled Boolean   @default(false) // nasce desligado; só o plano 017 liga, depois do OTA
  notifyEmail      String? // e-mail da Addere que recebe os avisos
  // Câmbio do custo de IA: PTAX venda do BCB, atualizada sozinha (a última que deu certo fica)
  usdBrlRate       Decimal?  @db.Decimal(10, 4)
  usdBrlRateAt     DateTime? // data e hora da cotação no BCB
  usdBrlFetchedAt  DateTime? // última consulta ao BCB que deu certo
  updatedAt        DateTime  @updatedAt

  @@map("billing_settings")
}

// ─── Contrato de licença de uso e aceite eletrônico (plano 014) ───

enum ContractDocumentKind {
  CONTRACT // Contrato de Licença de Uso
  AMENDMENT // aditivo
}

enum ContractTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContractDocumentStatus {
  SENT
  ACCEPTED
  CANCELLED
}

// Modelo do texto do contrato e do aditivo, versionado (plano 014). Markdown
// restrito com campos {{grupo.campo}}. Um só PUBLISHED por kind (garantido no
// serviço). Editar um publicado cria uma versão nova.
model ContractTemplate {
  id            String                 @id @default(uuid())
  kind          ContractDocumentKind
  version       Int
  status        ContractTemplateStatus @default(DRAFT)
  body          String
  changeNote    String?
  createdById   String? // null = gravado pela migration
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  documents          ContractDocument[] @relation("DocumentTemplate")
  conditionDocuments ContractDocument[] @relation("DocumentConditionsTemplate")

  @@unique([kind, version])
  @@index([kind, status])
  @@map("billing_contract_templates")
}

// Documento enviado para aceite (plano 014). renderedBody e sha256 nunca mudam
// depois de criados: o texto aceito é este, não o modelo atual.
model ContractDocument {
  id                String                 @id @default(uuid())
  kind              ContractDocumentKind
  status            ContractDocumentStatus @default(SENT)
  renderedBody      String
  sha256            String
  sentAt            DateTime               @default(now())
  sentById          String
  lastEmailAt       DateTime?
  acceptedAt        DateTime?
  acceptedById      String?
  acceptedByName    String? // congelado no aceite
  acceptedByEmail   String? // congelado no aceite
  acceptedIp        String?
  acceptedUserAgent String?
  cancelledAt       DateTime?
  cancelledById     String?
  cancelReason      String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  companyId            String
  company              Company           @relation(fields: [companyId], references: [id])
  contractId           String
  contract             CompanyContract   @relation(fields: [contractId], references: [id])
  termsId              String
  terms                ContractTerms     @relation(fields: [termsId], references: [id])
  templateId           String
  template             ContractTemplate  @relation("DocumentTemplate", fields: [templateId], references: [id])
  // Condições gerais que este documento carrega: o próprio modelo num CONTRACT;
  // num aditivo, só quando ele leva o cliente a uma versão nova.
  conditionsTemplateId String?
  conditionsTemplate   ContractTemplate? @relation("DocumentConditionsTemplate", fields: [conditionsTemplateId], references: [id])

  @@index([companyId, status])
  @@index([contractId, sentAt])
  @@map("billing_contract_documents")
}

// ═════════════════════════════════════════
// Faturamento (plano 016) — mensal, pós-pago, baixa manual
// Dinheiro Decimal(14,2); competência e vencimento em @db.Date
// ═════════════════════════════════════════

enum InvoiceStatus {
  OPEN // em aberto; "vencida" é derivada na leitura (OPEN e vencimento < hoje em SP)
  PAID // baixa dada; valores e itens ficam imutáveis
  CANCELLED // não será cobrada; continua ocupando a competência
}

enum InvoiceOrigin {
  JOB // gerada pelo agendador
  MANUAL // fatura avulsa, criada pelo superadmin
}

enum InvoiceItemKind {
  PACKAGE // valor total do pacote dos termos da competência
  EXTRA_SEATS // licenças adicionais × preço unitário
  DISCOUNT // desconto manual, gravado negativo
  ADJUSTMENT // acréscimo ou ajuste manual, com sinal
}

enum InvoicePaymentMethod {
  PIX
  BOLETO
  TRANSFER // TED ou DOC
  CARD
  OTHER
}

model Invoice {
  id         String        @id @default(uuid())
  number     Int           @unique @default(autoincrement()) // sequencial global (SERIAL)
  competence DateTime      @db.Date // dia 1 do mês cobrado
  dueDate    DateTime      @db.Date
  status     InvoiceStatus @default(OPEN)
  origin     InvoiceOrigin @default(JOB)
  termsId    String? // ContractTerms usados no cálculo; termos nunca são apagados
  total      Decimal       @db.Decimal(14, 2) // soma dos itens, refeita a cada mudança

  // Baixa
  paidAt        DateTime?             @db.Date // data do pagamento informada
  paidAmount    Decimal?              @db.Decimal(14, 2)
  paymentMethod InvoicePaymentMethod?
  paymentNote   String?
  paidById      String? // User.id de quem deu a baixa
  paidByName    String? // nome congelado na baixa

  nfNumber String? // NFS-e emitida por fora
  notes    String? // observação interna; o ADMIN do cliente não vê

  // Cancelamento
  cancelledAt     DateTime?
  cancelledById   String?
  cancelledByName String?
  cancelReason    String?

  createdById String? // null = agendador
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  items     InvoiceItem[]

  @@unique([companyId, competence]) // uma fatura por empresa e competência: é a idempotência do gerador
  @@index([status, dueDate])
  @@map("billing_invoices")
}

model InvoiceItem {
  id          String          @id @default(uuid())
  kind        InvoiceItemKind
  description String
  quantity    Int             @default(1)
  unitPrice   Decimal         @db.Decimal(14, 2)
  amount      Decimal         @db.Decimal(14, 2) // com sinal: DISCOUNT é negativo
  manual      Boolean         @default(false) // true sobrevive ao recálculo
  createdById String?
  createdAt   DateTime        @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("billing_invoice_items")
}

// ─── Licenças adicionais (plano 015) ───

enum LicenseRequestStatus {
  PENDING // aguardando o superadmin
  APPROVED // virou termos EFFECTIVE (origin LICENSE_REQUEST)
  REJECTED // recusado, com motivo
}

// Pedido de licenças do administrador indicado (plano 015). A declaração
// aceita é o aceite: aprovado, vira termos na hora, sem aditivo.
model LicenseRequest {
  id                 String               @id @default(uuid())
  quantity           Int
  message            String? // texto livre do ADMIN, até 500 caracteres
  unitPriceShown     Decimal              @db.Decimal(14, 2) // preço por licença mostrado no modal
  declarationText    String // a frase exata que o ADMIN viu
  declarationSha256  String // SHA-256 (hex) de declarationText
  requestedByName    String // congelado no pedido, como no aceite do contrato
  requestedByEmail   String
  requestedIp        String?
  requestedUserAgent String?
  status             LicenseRequestStatus @default(PENDING)
  decidedAt          DateTime?
  decisionReason     String? // obrigatório na recusa
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  requestedById    String
  requestedBy      User           @relation("LicenseRequestRequester", fields: [requestedById], references: [id])
  decidedById      String?
  decidedBy        User?          @relation("LicenseRequestDecider", fields: [decidedById], references: [id])
  resultingTermsId String?        @unique
  resultingTerms   ContractTerms? @relation(fields: [resultingTermsId], references: [id])

  @@index([companyId, status])
  @@index([status, createdAt])
  @@map("billing_license_requests")
}
